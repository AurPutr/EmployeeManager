import os
import sys
import tomllib
from pathlib import Path

import pandas as pd
import psycopg2


if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(errors="replace")  # TEISINGAI LIETUVIŠKŲ RAIDŽIŲ KONVERTAVIMUI IŠ .CSV FAILO

# PRISIJUNGIMO DUOMENYS
BASE_DIR = Path(__file__).resolve().parent


def get_database_url():
    """Grąžina PostgreSQL prisijungimo eilutę (DATABASE_URL)."""
    url = os.getenv("DATABASE_URL")
    if url:
        return url

    secrets_path = BASE_DIR / ".streamlit" / "secrets.toml"
    if secrets_path.exists():
        with secrets_path.open("rb") as file:
            return tomllib.load(file)["DATABASE_URL"]

    raise SystemExit(
        f"Nerastas DATABASE_URL. Sukurkite {secrets_path} su eilute:\n"
        'DATABASE_URL = "postgresql://user:password@localhost:5432/employeeManager"\n'
        'macOS atveju: DATABASE_URL = "postgresql://localhost:5432/employeeManager"'
    )


# STULPELIŲ ATITIKIMAS
# EXCEL/CSV STULPELIŲ PAVADINIMAI IR EIGA
COLUMNS = [
    "id",
    "name",
    "surname",
    "email",
    "team_id",
    "position_id",
    "ticketron_id",
    "do_evaluations",
    "start_date",
    "end_date",
    "status",
    "onboarded",
]


# FAILO PAIEŠKA IR NUSKAITYMAS
def find_source_file():
    """Suranda duomenų failą: pirmiausia Excel, po to CSV."""
    for file_name in ("employee.xlsx", "employee.csv"):  # excelio filo pavadinimai keiciami cia
        path = BASE_DIR / file_name
        if path.exists():
            return path

    raise SystemExit(f"Nerastas employees.xlsx arba employees.csv kataloge {BASE_DIR}")


def read_employees(path):
    """Nuskaito failą, pervadina stulpelius ir grąžina tik reikalingus stulpelius."""
    if path.suffix.lower() == ".xlsx":
        try:
            df = pd.read_excel(path)
        except ImportError:
            raise SystemExit(
                "Excel failui nuskaityti reikia openpyxl bibliotekos:\n"
                "pip3 install openpyxl"
            )
    else:
        df = pd.read_csv(path, encoding="utf-8")
    df.columns = [str(column).strip() for column in df.columns]

    return df[COLUMNS]


# SQL UŽKLAUSOS
# TODO: ČIA REIKIA PERRAŠYTI KIEKVIENĄ KARTĄ KURIANT NAUJĄ LENTELĘ (tavo komentaras: imit info is main.py ir ikelti lenteliu info cia)
CREATE_TABLE_SQL = """
    CREATE TABLE IF NOT EXISTS employee (
        id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name VARCHAR(100) NOT NULL,
        surname VARCHAR(100) NOT NULL,
        email VARCHAR(255) NOT NULL UNIQUE,
        team_id VARCHAR(255),
        position_id VARCHAR(255),
        ticketron_id INTEGER,
        do_evaluations BOOLEAN DEFAULT FALSE,
        start_date DATE,
        end_date DATE,
        status VARCHAR(50),
        onboarded BOOLEAN DEFAULT FALSE,
        created_at TIMESTAMP NOT NULL DEFAULT NOW(),
        updated_at TIMESTAMP NOT NULL DEFAULT NOW()
    )
"""

# VALUES TURI SUTAPTI SU PAVADINIMŲ KIEKIU (ir ID čia nedėti IR - vienas %s, kad sutaptų collumn skaičius su values dedamų)
INSERT_SQL = """
    INSERT INTO employee (
        name, surname, email, team_id, position_id, ticketron_id,
        do_evaluations, start_date, end_date, status, onboarded
    )
    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    ON CONFLICT (id) DO UPDATE SET
        name = EXCLUDED.name,
        surname = EXCLUDED.surname,
        email = EXCLUDED.email,
        team_id = EXCLUDED.team_id,
        position_id = EXCLUDED.position_id,
        ticketron_id = EXCLUDED.ticketron_id,
        do_evaluations = EXCLUDED.do_evaluations,
        start_date = EXCLUDED.start_date,
        end_date = EXCLUDED.end_date,
        status = EXCLUDED.status,
        onboarded = EXCLUDED.onboarded
"""
# nededam ID ir created_at ir updated_at on conflict dalyje

SYNC_SEQUENCE_SQL = """
    SELECT setval(
        pg_get_serial_sequence('employee', 'id'),
        COALESCE(MAX(id), 0) + 1,
        false
    )
    FROM employee
"""


def convert_dates(series):
    """Paverčia stulpelį į datų sąrašą; tuščios vietų -> None (SQL NULL)."""
    parsed = pd.to_datetime(series, errors="coerce")
    return [None if pd.isna(value) else value.date() for value in parsed]


# PO MŪSŲ MEETO TECHNIŠKAI TIK ČIA PAKEIČIAU VISKĄ, KAD LEISTŲ NONE DĖTI VERTES
def build_rows(df):
    """DataFrame paverčia sąrašu eilučių, tinkamų siųsti į INSERT užklausą."""
    df = df.copy()

    # Datos: NaN/NaT -> None -> SQL NULL (jau veikia per convert_dates)
    df["start_date"] = convert_dates(df["start_date"])
    df["end_date"] = convert_dates(df["end_date"])

    # BOOLEAN stulpeliai: NaN (float) -> None, kad psycopg2 įrašytų NULL
    for col in ("do_evaluations", "onboarded"):
        df[col] = df[col].map(lambda v: None if pd.isna(v) else bool(v))

    # Tekstiniai (VARCHAR) stulpeliai: NaN -> None, kiti -> strip()
    for column in ("name", "surname", "email", "status"):
        df[column] = df[column].map(
            lambda v: None if pd.isna(v) else str(v).strip()
        )

    # team_id, position_id — VARCHAR(255), NaN -> None
    for column in ("team_id", "position_id"):
        df[column] = df[column].map(
            lambda v: None if pd.isna(v) else str(v).strip()
        )

    # ticketron_id — INTEGER, NaN -> None
    df["ticketron_id"] = df["ticketron_id"].map(
        lambda v: None if pd.isna(v) else int(v)
    )

    # COLUMNS be "id" (Paliekame PostgreSQL generuoti)
    columns_no_id = [c for c in COLUMNS if c != "id"]
    return list(df[columns_no_id].itertuples(index=False, name=None))


def main():
    """Pagrindinė programa: nuskaitymas -> įrašymas -> patikrinimas."""
    source = find_source_file()
    print(f'Nuskaitomas failas: {source.name}')

    df = read_employees(source)
    rows = build_rows(df)
    print(f'Rasta eilučių: {len(rows)}')

    conn = psycopg2.connect(get_database_url())
    cursor = conn.cursor()

    try:
        cursor.execute(CREATE_TABLE_SQL)
        conn.commit()

        cursor.executemany(INSERT_SQL, rows)
        conn.commit()
        print(f'Įkelta į lentelę employee: {cursor.rowcount}')

        cursor.execute(SYNC_SEQUENCE_SQL)
        conn.commit()

        cursor.execute("SELECT * FROM employee ORDER BY id")
        for row in cursor.fetchall():
            print(row)

        cursor.execute("SELECT COUNT(*) FROM employee")
        print(f"Iš viso lentelėje: {cursor.fetchone()[0]}")
    finally:
        cursor.close()
        conn.close()


if __name__ == "__main__":
    main()
